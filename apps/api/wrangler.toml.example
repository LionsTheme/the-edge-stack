# ═══════════════════════════════════════════════════════════
# THE EDGE STACK - API WORKER CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Este es un archivo de ejemplo. Cópialo como wrangler.toml:
#   cp wrangler.toml.example wrangler.toml
# Luego configura los secrets con:
#   wrangler secret put DATABASE_URL
#   wrangler secret put AUTH_SECRET
#   wrangler secret put GOOGLE_CLIENT_SECRET
# ═══════════════════════════════════════════════════════════

name = "the-edge-stack-api"
main = "src/index.ts"
compatibility_date = "2024-04-03"

# ═══════════════════════════════════════════════════════════
# BUILD CONFIGURATION (Workers Builds / Custom Build)
# ═══════════════════════════════════════════════════════════
[build]
command = "npm run build"

# ═══════════════════════════════════════════════════════════
# PERFORMANCE & LIMITS
# ═══════════════════════════════════════════════════════════
# Define resource limits for production. Free plan defaults:
# - CPU: 50ms per request
# - Subrequests: 50 per request
# - Memory: 128MB
[limits]
# cpu_ms = 30000  # Uncomment to override (default: 30000 = 30s)
# subrequests = 50  # Uncomment to override

# ═══════════════════════════════════════════════════════════
# BUNDLE OPTIMIZATION
# ═══════════════════════════════════════════════════════════
# Exclude files from the Worker bundle to reduce size
[rules]
# type = "Text"
# globs = ["**/*.md"]
# fallthrough = true

# ═══════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES (Públicas)
# ═══════════════════════════════════════════════════════════
[vars]
APP_URL = "http://localhost:8787"

# Para producción, usa environments:
# [env.production.vars]
# APP_URL = "https://tu-dominio.com"

# Para preview (Pull Requests):
# [env.preview.vars]
# APP_URL = "https://preview.tu-dominio.com"

# ═══════════════════════════════════════════════════════════
# SECRETS (configurar con wrangler secret put)
# ═══════════════════════════════════════════════════════════
# Estos valores NO van en este archivo. Se configuran con:
#
#   wrangler secret put DATABASE_URL
#   wrangler secret put AUTH_SECRET
#   wrangler secret put GOOGLE_CLIENT_ID
#   wrangler secret put GOOGLE_CLIENT_SECRET
#
# En desarrollo local, usa .dev.vars:
#   apps/api/.dev.vars
# ═══════════════════════════════════════════════════════════

# Opcional: D1 Database (si decides usarla en lugar de Neon)
# [[d1_databases]]
# binding = "DB"
# database_name = "the-edge-stack-db"
# database_id = "your-database-id"

# Opcional: KV Namespace (para sesiones o caché)
# [[kv_namespaces]]
# binding = "CACHE"
# id = "your-kv-namespace-id"
# preview_id = "your-kv-preview-id"