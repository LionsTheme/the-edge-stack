# ═══════════════════════════════════════════════════════════
# THE EDGE STACK - VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════
# Este archivo es un template. Copia este archivo como .env y completa
# los valores reales para tu entorno.
#
# INSTRUCCIONES RÁPIDAS:
# 1. Copia: cp .env.example .env
# 2. Completa los valores siguiendo las guías de cada sección
# 3. NUNCA commitees el archivo .env (ya está en .gitignore)
# ═══════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────┐
# │  SECCIÓN 1: BASE DE DATOS (Neon PostgreSQL)             │
# └─────────────────────────────────────────────────────────┘

# DATABASE_URL
# ─────────────────────────────────────────────────────────
# URL de conexión a tu base de datos Neon PostgreSQL.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://neon.tech y crea una cuenta (o inicia sesión)
# 2. Crea un nuevo proyecto
# 3. Crea una base de datos (por defecto se llama "neondb")
# 4. Ve a "Connection Details" en el dashboard
# 5. Copia la URL de conexión (empieza con postgresql://)
#
# FORMATO:
# postgresql://<usuario>:<contraseña>@<host>/<database>?sslmode=require
#
# EJEMPLO:
# postgresql://john:supersecret@ep-ancient-star-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# NOTAS:
# - Neon requiere SSL en conexiones externas (sslmode=require)
# - Si usas un branch de preview, usa la URL del branch específico
# - Para desarrollo local puedes usar PostgreSQL local cambiando la URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require


# ┌─────────────────────────────────────────────────────────┐
# │  SECCIÓN 2: AUTENTICACIÓN (Better Auth)                 │
# └─────────────────────────────────────────────────────────┘

# BETTER_AUTH_SECRET
# ─────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT y cookies de sesión.
# Debe tener al menos 32 caracteres y ser completamente aleatoria.
#
# ¿Cómo generar uno?
# Opción A (Linux/Mac):
#   openssl rand -base64 32
#
# Opción B (Node.js):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Opción C (online):
#   Ve a https://generate-secret.vercel.app/32
#
# SEGURIDAD:
# - NUNCA compartas este secreto
# - Usa valores diferentes para cada entorno (dev, staging, prod)
# - Rótalo periódicamente
# - En producción, usa un secret manager (Cloudflare Secrets, etc.)
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-must-be-random

# BETTER_AUTH_URL
# ─────────────────────────────────────────────────────────
# URL pública donde se ejecuta tu aplicación.
# Better Auth usa esta URL para generar callbacks de OAuth
# y redirecciones post-autenticación.
#
# ENTORNOS:
# - Desarrollo local: http://localhost:8787 (API) o http://localhost:3000 (dashboard)
# - Preview/Staging: https://staging.tudominio.com
# - Producción: https://tudominio.com
#
# IMPORTANTE:
# - Debe coincidir con la URL configurada en Google OAuth Console
# - Para previews de Cloudflare, usa la URL generada automáticamente
BETTER_AUTH_URL=http://localhost:8787


# ┌─────────────────────────────────────────────────────────┐
# │  SECCIÓN 3: OAUTH (Google)                              │
# └─────────────────────────────────────────────────────────┘

# GOOGLE_CLIENT_ID
# ─────────────────────────────────────────────────────────
# Client ID de la aplicación OAuth 2.0 de Google.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto (o selecciona uno existente)
# 3. Ve a "APIs & Services" → "Credentials"
# 4. Haz clic en "CREATE CREDENTIALS" → "OAuth client ID"
# 5. Selecciona "Web application"
# 6. En "Authorized redirect URIs" añade:
#    http://localhost:8787/api/auth/callback/google (desarrollo)
#    https://tudominio.com/api/auth/callback/google (producción)
# 7. Guarda y copia el "Client ID"
#
# FORMATO:
# Un string largo terminado en .apps.googleusercontent.com
#
# EJEMPLO:
# 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET
# ─────────────────────────────────────────────────────────
# Client Secret de la aplicación OAuth 2.0 de Google.
# Se genera junto con el Client ID en el paso anterior.
#
# SEGURIDAD:
# - Trátalo como una contraseña
# - Nunca lo expongas en el frontend
# - En producción, úsalo como secret de Cloudflare Workers
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ┌─────────────────────────────────────────────────────────┐
# │  SECCIÓN 4: CLOUDFLARE (Wrangler CLI)                   │
# └─────────────────────────────────────────────────────────┘

# CLOUDFLARE_ACCOUNT_ID
# ─────────────────────────────────────────────────────────
# ID de tu cuenta de Cloudflare. Se usa con Wrangler CLI para
# desplegar Workers y Pages.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://dash.cloudflare.com
# 2. En la barra lateral derecha, verás "Account ID"
# 3. También puedes encontrarlo en la URL del dashboard
#
# EJEMPLO:
# 1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# CLOUDFLARE_API_TOKEN
# ─────────────────────────────────────────────────────────
# Token de API para autenticar Wrangler CLI con Cloudflare.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://dash.cloudflare.com/profile/api-tokens
# 2. Haz clic en "Create Token"
# 3. Usa el template "Edit Cloudflare Workers"
# 4. O crea uno custom con estos permisos:
#    - Zone:Read (para todas las zonas)
#    - Workers Scripts:Edit
#    - Account:Read
#    - Cloudflare Pages:Edit
# 5. Guarda el token (solo se muestra una vez)
#
# ALTERNATIVA (menos segura):
# Puedes usar tu Global API Key, pero el API Token es preferido
# por tener permisos más granularizados.
#
# USO:
# wrangler login          # Login interactivo (alternativa al token)
# wrangler whoami         # Verificar autenticación
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token


# ┌─────────────────────────────────────────────────────────┐
# │  SECCIÓN 5: VARIABLES OPCIONALES                        │
# └─────────────────────────────────────────────────────────┘

# DASH_URL
# ─────────────────────────────────────────────────────────
# URL del dashboard de Cloudflare Workers.
# Se usa para generar enlaces directos a tu dashboard desde la CLI.
# Para desarrollo local, puedes usar http://localhost:3000
DASH_URL=http://localhost:3000

# TURBO_TOKEN (opcional)
# ─────────────────────────────────────────────────────────
# Token para Turborepo Remote Cache.
# Permite compartir builds entre CI y desarrolladores.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://vercel.com/account/tokens
# 2. Crea un token con scope "Full Account"
# 3. Configura el remote cache:
#    pnpm turbo login
#    pnpm turbo link
#
# TURBO_TOKEN=your-turbo-token

# NEON_API_KEY (opcional, para CI/CD branching)
# ─────────────────────────────────────────────────────────
# API key de Neon para crear branches automáticamente
# en Pull Requests.
#
# ¿Cómo obtenerlo?
# 1. Ve a https://console.neon.tech
# 2. Ve a Account Settings → API Keys
# 3. Genera una nueva API key
#
# NEON_API_KEY=your-neon-api-key