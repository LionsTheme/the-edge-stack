{
	"name": "@repo/api",
	"type": "module",
	"exports": {
		".": "./src/routes.ts"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"deploy:with-migration": "pnpm --filter @repo/database db:migrate && wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf .wrangler node_modules"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.6",
		"better-auth": "^1.6.9",
		"@repo/database": "workspace:*",
		"hono": "^4.12.18",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@repo/biome-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@biomejs/biome": "2.4.14",
		"@cloudflare/workers-types": "^4.20260508.1",
		"@types/node": "25.6.2",
		"wrangler": "^4.90.0"
	}
}
