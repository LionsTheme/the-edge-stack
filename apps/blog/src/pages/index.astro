---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog - The Edge Stack">
  <main class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-8">Blog</h1>
    <div class="space-y-8">
      <article class="p-6 rounded-lg border bg-card">
        <h2 class="text-2xl font-semibold mb-2">Welcome to the Edge</h2>
        <p class="text-muted-foreground mb-4">
          Exploring the benefits of edge-first architecture for modern web applications.
        </p>
        <a href="#" class="text-primary hover:underline">Read more →</a>
      </article>
    </div>
  </main>
</Layout>