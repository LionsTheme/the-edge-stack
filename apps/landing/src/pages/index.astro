---
import { env } from "cloudflare:workers";
import { buttonVariants } from "@repo/ui/components/button";
import { ArrowRight, Layers, Shield, Zap } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";

const dashboardUrl = env.DASHBOARD_URL ?? import.meta.env.DASHBOARD_URL;
const loginUrl = dashboardUrl ? `${dashboardUrl}/sign-in` : "#";

const features = [
	{
		icon: Zap,
		title: "Lightning Fast",
		description:
			"Edge computing ensures your users get sub-millisecond responses worldwide.",
	},
	{
		icon: Shield,
		title: "Secure by Default",
		description:
			"Built-in authentication and row-level security keep your data safe.",
	},
	{
		icon: Layers,
		title: "Modern Stack",
		description:
			"Turbocharged monorepo with Astro, Cloudflare Workers, and shadcn/ui.",
	},
];
---

<BaseLayout
	title="The Edge Stack — Ship at the Edge"
	description="A production-ready monorepo starter for building modern, edge-native applications."
>
	<main class="flex min-h-screen flex-col">
		<!-- Nav -->
		<header class="container mx-auto flex items-center justify-between px-6 py-5">
			<div class="flex items-center gap-2.5">
				<img src="/favicon.svg" alt="Logo" class="h-8 w-8" />
				<span class="text-lg font-semibold tracking-tight">The Edge Stack</span>
			</div>
			<nav class="hidden items-center gap-6 text-sm text-muted-foreground sm:flex">
				<a href="#" class="hover:text-foreground transition-colors">Docs</a>
				<a href="#" class="hover:text-foreground transition-colors">About</a>
			</nav>
			<a href={loginUrl} class={buttonVariants({ size: "lg" })}>
				Sign In
			</a>
		</header>

		<!-- Hero -->
		<section class="flex flex-1 flex-col items-center justify-center px-6 text-center">
			<div
				class="mx-auto mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground"
			>
				<span class="relative flex h-2 w-2">
					<span
						class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
					></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
				</span>
				Now available on Cloudflare Pages
			</div>

			<h1
				class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
			>
				Ship your next idea
				<span class="text-primary/70"> at the edge</span>
			</h1>

			<p class="mt-6 max-w-xl text-lg text-muted-foreground leading-relaxed">
				A production-ready monorepo starter built with Astro, React, Cloudflare
				Workers, and shadcn/ui. Fork it, customize it, ship it.
			</p>

			<div class="mt-10 flex flex-col gap-3 sm:flex-row">
				<a
					href={loginUrl}
					class={buttonVariants({ size: "lg" })}
				>
					<ArrowRight class="h-4 w-4" />
					Open Dashboard
				</a>
				<a
					href="https://github.com"
					class={buttonVariants({ variant: "outline", size: "lg" })}
				>
					View on GitHub
				</a>
			</div>
		</section>

		<!-- Features -->
		<section class="border-t border-border px-6 py-24">
			<div class="container mx-auto">
				<h2 class="text-center text-2xl font-bold tracking-tight sm:text-3xl">
					Everything you need to launch
				</h2>
				<p class="mt-3 text-center text-muted-foreground">
					Batteries included. Opinions you can override.
				</p>

				<div
					class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
				>
					{
						features.map(({ icon: Icon, title, description }) => (
							<div class="flex flex-col items-center rounded-xl border border-border bg-card p-6 text-center">
								<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary">
									<Icon class="h-6 w-6" />
								</div>
								<h3 class="mt-4 font-semibold">{title}</h3>
								<p class="mt-2 text-sm text-muted-foreground leading-relaxed">
									{description}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-border px-6 py-8">
			<div
				class="container mx-auto flex flex-col items-center justify-between gap-4 text-sm text-muted-foreground sm:flex-row"
			>
				<p>&copy; {new Date().getFullYear()} The Edge Stack. MIT License.</p>
				<nav class="flex gap-4">
					<a href="#" class="hover:text-foreground transition-colors">Docs</a>
					<a href="#" class="hover:text-foreground transition-colors">GitHub</a>
				</nav>
			</div>
		</footer>
	</main>
</BaseLayout>
