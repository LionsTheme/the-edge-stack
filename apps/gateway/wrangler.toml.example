# ═══════════════════════════════════════════════════════════
# THE EDGE STACK - GATEWAY WORKER CONFIGURATION
# ═══════════════════════════════════════════════════════════
# Este es un archivo de ejemplo. Cópialo como wrangler.toml:
#   cp wrangler.toml.example wrangler.toml
#
# El Gateway enruta el tráfico a todos los micro-frontends
# bajo un mismo dominio, eliminando CORS.
# ═══════════════════════════════════════════════════════════

name = "the-edge-stack-gateway"
main = "src/index.ts"
compatibility_date = "2024-04-03"

# ═══════════════════════════════════════════════════════════
# SERVICE BINDINGS
# ═══════════════════════════════════════════════════════════
# Conecta este Gateway con los otros Workers.
# Cada binding representa un micro-frontend.
#
# IMPORTANTE: Los Workers referenciados deben estar desplegados
# en la misma cuenta de Cloudflare.
# ═══════════════════════════════════════════════════════════

[[services]]
binding = "API"
service = "the-edge-stack-api"

[[services]]
binding = "DASHBOARD"
service = "the-edge-stack-dashboard"

[[services]]
binding = "BLOG"
service = "the-edge-stack-blog"

[[services]]
binding = "LANDING"
service = "the-edge-stack-landing"

[[services]]
binding = "DOCS"
service = "the-edge-stack-docs"

# Para entornos de preview (opcional):
# [env.preview.services]
# binding = "API"
# service = "the-edge-stack-api-preview"