{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "the-edge-stack-gateway",
	"compatibility_date": "2026-05-05",
	"main": "src/index.ts",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "API",
			"service": "api"
		},
		{
			"binding": "DASH",
			"service": "dash"
		},
		{
			"binding": "BLOG",
			"service": "blog"
		},
		{
			"binding": "LANDING",
			"service": "landing"
		},
		{
			"binding": "DOCS",
			"service": "docs"
		}
	]
}
